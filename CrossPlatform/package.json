{
  "name": "handmirror-cross-platform",
  "version": "0.1.0",
  "description": "A tiny circular camera mirror for macOS and Windows.",
  "main": "src/main.js",
  "author": "HandMirror Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "^26.8.1"
  },
  "build": {
    "appId": "dev.codex.handmirror",
    "productName": "HandMirror",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSCameraUsageDescription": "단축키로 동그란 손거울 카메라 미리보기를 표시하기 위해 카메라 접근이 필요합니다."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
